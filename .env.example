# ==========================================================
# 24/7 Cortana & J.A.R.V.I.S. Cognitive Command Configuration
# Copy this file to .env and fill in your actual credentials.
# ==========================================================

# 1. Telegram Bot Credentials
# Get bot token from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 2. Supabase Database Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Used by Python bot to write data (bypasses RLS)
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Used by the Vercel Web Dashboard to read data (read-only safe)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. AI Cognitive Engine (Dual Engine: Google Gemini + Groq)
# Get your Google Gemini key at https://aistudio.google.com/apikey (250k-1M TPM free quota)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional multi-key rotation pool (comma-separated for zero-429 rate limit immunity)
GROQ_API_KEYS=gsk_key1,gsk_key2
OPENROUTER_API_KEY=
LOCAL_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions

# 4. Neural Voice & Speaker Settings
# en-US-AriaNeural (Cortana female tone) or en-GB-RyanNeural (JARVIS tone)
CONSTRUCT_VOICE=en-US-AriaNeural
ENABLE_LOCAL_SPEAKER=false

# 5. Planetary OSINT & Reconnaissance Settings
# Optional rotating proxy pool for Tier-2 walled-garden harvesters
OSINT_PROXY_LIST=
# Optional Discord Bot Token for Tier-1 public server channel ingestion
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# 6. Telemetry Sync & Telegram Dispatch Cadence (in seconds)
# Background sensor sweeps run every 300 seconds (5 mins) to catch breaking news & update Web HUD
SYNC_INTERVAL=300
# Routine Telegram SitRep broadcast interval: 1800 seconds (30 minutes) unless requested on-demand
# 7. 24/7 Sovereign Cloud Daemon & Repository Tokens
# Allows 24/7 Vercel serverless functions to commit created tools & evolve code even when laptop is offline
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
CRON_SECRET=YOUR_CRON_TRIGGER_SECRET


