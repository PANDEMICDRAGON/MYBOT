# ==========================================================
# 24/7 Web Collector Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==========================================================

# Telegram Bot Credentials
# Get bot token from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Supabase Database Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use service_role secret key for backend access
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Scraping Schedule Interval (in seconds)
# Default is 300 seconds (5 minutes)
SCRAPE_INTERVAL=300

# Future AI Integration (Optional for now)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
