# ==========================================================
# 24/7 Web Collector, Weather & News Bot Configuration
# Copy this file to .env and fill in your actual credentials.
# ==========================================================

# 1. Telegram Bot Credentials
# Get bot token from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 2. Supabase Database Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Used by Python bot to write data (bypasses RLS)
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Used by the Vercel Web Dashboard to read data (read-only safe)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. Telemetry Sync Schedule (in seconds)
# Default is 900 seconds (15 minutes)
SYNC_INTERVAL=900

# 4. Optional Future AI Integration (Gemini, Groq, etc.)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
