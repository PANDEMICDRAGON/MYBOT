# ==========================================================
# 24/7 Cortana & J.A.R.V.I.S. Cognitive Command Configuration
# Copy this file to .env and fill in your actual credentials.
# ==========================================================

# 1. Telegram Bot Credentials
# Get bot token from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Get your numeric user ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 2. Supabase Database Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Used by Python bot to write data (bypasses RLS)
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Used by the Vercel Web Dashboard to read data (read-only safe)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. AI Cognitive Engine (Dual Engine: Google Gemini + Groq)
# Get your Google Gemini key at https://aistudio.google.com/apikey (250k-1M TPM free quota)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Get your Groq key at https://console.groq.com (Dedicated Whisper audio transcription + backup failover)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# 4. Telemetry Sync & Telegram Dispatch Cadence (in seconds)
# Background sensor sweeps run every 300 seconds (5 mins) to catch breaking news & update Web HUD
SYNC_INTERVAL=300
# Routine Telegram SitRep broadcast interval: 1800 seconds (30 minutes) unless requested on-demand
TELEGRAM_DISPATCH_INTERVAL=1800


